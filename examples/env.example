# synthlite environment — copy to .env, fill in, then: set -a; . ./.env; set +a
# Never commit the filled-in file.

# Generate with one OpenAI-compatible endpoint. Ignored when the config file has [[key]].
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# SYNTHLITE_MODEL overrides OPENAI_MODEL.
# SYNTHLITE_MODEL=
# SYNTHLITE_SYSTEM_PROMPT overrides [generation].system_message.
# SYNTHLITE_SYSTEM_PROMPT=

# Variables named by [[key]] api_key_env in a config file.
# examples/configs/openrouter-free.toml and detailed-sia.toml:
OPENROUTER_API_KEY=sk-or-replace-me
# examples/configs/vllm.toml and ollama.toml (any non-empty value works):
# VLLM_API_KEY=local
# OLLAMA_API_KEY=ollama
# GROQ_API_KEY=gsk_replace-me

# Push (Hugging Face, write access). HUGGING_FACE_HUB_TOKEN is the fallback.
HF_TOKEN=hf_replace-me
